<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <form action="<%= editing ? `/admin/terminal/${terminalData._id}` : '/admin/terminal' %>" method="POST">
    <label for="name">Terminal Name:</label>
    <input type="text" id="name" name="terminal" value="<%= editing ? terminalData.terminal : '' %>" required>
    <button type="submit"><%= editing ? 'Update Terminal' : 'Add Terminal' %></button>
  </form>


  <table border="1" cellspacing="0" >
    <tr>
      <th>Terminal Name</th>
      <th>Actions</th>
    </tr>
    <% terminalList.forEach((term)=>{%>
    <tr>
      <td><%= term.terminal %></td>
      <td>
       <a href="/admin/terminal/<%= term._id %>/edit-terminal?editing=true">Edit</a>
       <a href="/delete/terminal/<%= term._id %>"><button onclick="return confirm('Are you sure you want to delete <%= term.terminal %> terminal?')">Delete</button></a>
      </td>
    </tr>
  <% }) %>
  </table>
</body>
</html>