<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CrossSheet</title>
</head>
<body>

  <select name="subjectClass" id="subjectClass">
    <option value="" selected disabled>--choose a class and subject--</option>
    <option value="/crossheet?class=5&subject=Math">Class 5-Math</option>
    <option value="/crossheet?class=4&section=chanakya">Class 4-chanakya</option>
  </select>

  <script>
    document.getElementById('subjectClass').addEventListener('change', function() {
      window.location.href = this.value;
    });

  </script>


  <div>select term</div><br>
  <div>first</div>
  <div>second</div>
  <div>third</div>


  <table border="1" cellspacing="0" cellpadding="5">
    <thead>
      <tr>
        <th>Reg.No</th>
        <th>Name</th>
        <th>Roll</th>
        <th>Class</th>
        <th>Section</th>
        <th>Subject</th>
      </tr>
    </thead>
    <tbody>
      <% for (let i = 0; i < 10; i++) { %>
        <tr>
          <td>Row <%= i + 1 %> - First</td>
          <td>Row <%= i + 1 %> - Second</td>
          <td>Row <%= i + 1 %> - Third</td>
        </tr>
      <% } %>
    </tbody>

  </table>
</body>
</html>